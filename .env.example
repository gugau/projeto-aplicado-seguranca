# Copie para .env apenas em desenvolvimento. O arquivo .env nunca deve ser commitado.
# O Flask deste projeto não carrega .env automaticamente; exporte as variáveis no terminal.
APP_ENV=development
SECRET_KEY=substitua-por-uma-chave-aleatoria-de-64-caracteres
APP_USERNAME=admin
APP_PASSWORD_HASH=substitua-pelo-hash-gerado
SESSION_MINUTES=30
